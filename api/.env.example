# Copy to .env for local development. Never commit real values.
SPRUCE_ENV=dev
SPRUCE_DATABASE_URL=postgresql+psycopg://spruce:spruce@127.0.0.1:5432/spruce
SPRUCE_REDIS_URL=redis://127.0.0.1:6379/0
SPRUCE_CORS_ORIGINS=["http://localhost:3000"]
# Generate each with: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SPRUCE_DATA_KEY=
SPRUCE_INDEX_KEY=
# Local http only. Production must keep cookies Secure.
SPRUCE_COOKIE_SECURE=false
SPRUCE_EMAIL_BACKEND=console
